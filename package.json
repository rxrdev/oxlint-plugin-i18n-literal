{
    "name": "@rrazvan.dev/oxlint-plugin-i18n-literal",
    "version": "1.0.0",
    "description": "oxlint rules that flag untranslated user-visible string literals in JSX",
    "keywords": [
        "oxlint",
        "oxlint-plugin",
        "i18n",
        "i18next",
        "lint",
        "jsx"
    ],
    "license": "MIT",
    "author": "Razvan Rauta",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rxrdev/oxlint-plugin-i18n-literal.git"
    },
    "homepage": "https://github.com/rxrdev/oxlint-plugin-i18n-literal#readme",
    "bugs": {
        "url": "https://github.com/rxrdev/oxlint-plugin-i18n-literal/issues"
    },
    "type": "module",
    "main": "./src/index.mjs",
    "exports": {
        ".": "./src/index.mjs"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22"
    },
    "peerDependencies": {
        "oxlint": ">=1.70.0"
    },
    "scripts": {
        "test": "node --test 'tests/unit/**/*.test.mjs' 'tests/integration/**/*.test.mjs'",
        "test:unit": "node --test 'tests/unit/**/*.test.mjs'",
        "test:integration": "node --test 'tests/integration/**/*.test.mjs'"
    },
    "devDependencies": {
        "oxlint": "^1.76.0"
    }
}
