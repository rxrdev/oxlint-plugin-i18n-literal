{
    "plugins": ["react", "typescript"],
    "jsPlugins": [
        { "name": "i18n-literal", "specifier": "../../../../src/index.mjs" }
    ],
    "categories": { "correctness": "off" },
    "settings": { "i18n-literal": { "presets": ["react"] } },
    "rules": {
